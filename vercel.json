{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @weddyzone/shared build && pnpm --filter @weddyzone/web build",
  "outputDirectory": "apps/web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://REPLACE_WITH_API_HOST/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
