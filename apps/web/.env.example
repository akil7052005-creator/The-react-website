# Leave empty to call the API through the same origin (/api is proxied by Vite in
# development and rewritten by vercel.json in production).
VITE_API_URL=
# AI Face Recognition is out of scope for v1: keep this false.
FEATURE_FACE_RECOGNITION=false
# Where `pnpm dev` proxies /api to
VITE_DEV_API_PROXY=http://localhost:4000
# Customer links in "Send Options" (Photo Selection → Send). Leave the store links empty until the apps are live.
VITE_ANDROID_APP_URL=
VITE_IOS_APP_URL=
# Public address of this web app; the web link is {VITE_PUBLIC_APP_URL}/selection/auth (empty = this site).
VITE_PUBLIC_APP_URL=
# Wi-Fi testing only: true lets VITE_PUBLIC_APP_URL be this computer's network address (e.g. http://192.168.1.4:5173)
# so phones on the same Wi-Fi can open customer links. localhost/127.0.0.1 are always refused. Ignored in production builds.
VITE_ALLOW_LAN_LINKS=false
# Name in "Powered by …" on the customer pages.
VITE_APP_NAME=Wedmanage Studio
