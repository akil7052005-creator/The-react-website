# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in links: selection/album/website/reset password)
APP_URL=http://localhost:5173
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://weddyzone@localhost:5433/weddyzone?schema=public
# Used by the API test suite (it is wiped before every test file)
TEST_DATABASE_URL=postgresql://weddyzone@localhost:5433/weddyzone_test?schema=public

# --- Auth -----------------------------------------------------------------
# Use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Platform admins (/admin) are signed out after this many hours without activity
ADMIN_SESSION_HOURS=8
# lax when the web app proxies /api (same site); none when API is on another site (requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Uploads --------------------------------------------------------------------
# Development: files are saved on disk under UPLOAD_DIR.
UPLOAD_DIR=./uploads
# Production: S3-compatible bucket (Cloudflare R2 or AWS S3). Setting S3_BUCKET switches uploads to it
# (required when NODE_ENV=production). Keep the bucket private; the API checks access and streams files.
S3_BUCKET=
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com · AWS S3: leave empty
S3_ENDPOINT=
# R2: auto · AWS S3: the bucket's region, e.g. ap-south-1
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only for S3-compatible servers that need path-style URLs (e.g. MinIO); not R2 or AWS
S3_FORCE_PATH_STYLE=false
MAX_PHOTO_MB=20
MAX_BANNER_MB=5

# --- Email. Without RESEND_API_KEY or SMTP_HOST, emails are only logged to the console (dev). --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Weddyzone Studio <no-reply@weddyzone.app>"
# Resend (recommended): API key from resend.com. When set, emails go through Resend instead of SMTP.
RESEND_API_KEY=
# Sender for all emails; its domain must be verified in Resend. Required in production.
MAIL_FROM="Weddyzone Studio <no-reply@weddyzone.app>"

# --- Rate limits (requests per minute) --------------------------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PUBLIC_PER_MIN=120
# Proxies in front of the API: 1 locally / direct, 2 behind Vercel's /api rewrite + Railway/Render
TRUST_PROXY_HOPS=1

# --- Subscriptions & platform alerts -------------------------------------------
# Hourly job: deadline reminders (T-7/3/1), grace -> read-only, admin digest. Set false to turn off.
JOBS_ENABLED=true
# Payment gateway webhook secret (Razorpay: Settings -> Webhooks). Webhook URL: https://<api>/api/v1/webhooks/payments
# Without it the webhook endpoint refuses every call; test-mode purchases don't need it.
PAYMENT_WEBHOOK_SECRET=
# Extra recipients for admin alert emails and the daily digest (every admin's own email gets them too)
ADMIN_ALERT_EMAILS=
# Seller details on Weddyzone's GST invoices to studios
PLATFORM_LEGAL_NAME="Weddyzone Studio"
PLATFORM_GSTIN=
PLATFORM_STATE_CODE=
PLATFORM_ADDRESS=
# WhatsApp Cloud API for platform alerts to studios (approved templates; never uses studio credits).
# Without these, WhatsApp alerts are recorded with their text and wa.me link but not delivered.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=en
# Encrypts admins' two-factor secrets (default: derived from JWT_REFRESH_SECRET)
ADMIN_2FA_KEY=
RATE_LIMIT_ADMIN_PER_MIN=120
# Photo uploads have their own bucket (a 1,000-photo folder is 1,000 requests in a minute or two)
RATE_LIMIT_UPLOADS_PER_MIN=6000

# Mirrors the web flag; reported to the web app via /auth/me
FEATURE_FACE_RECOGNITION=false

# Used by Playwright (reset + seeded before every e2e run)
E2E_DATABASE_URL=postgresql://weddyzone@localhost:5433/weddyzone_e2e?schema=public
