# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in links: selection/album/website/reset password)
APP_URL=http://localhost:5173
# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://weddyzone@localhost:5433/weddyzone?schema=public
# Used by the API test suite (it is wiped before every test file)
TEST_DATABASE_URL=postgresql://weddyzone@localhost:5433/weddyzone_test?schema=public

# --- Auth -----------------------------------------------------------------
# Use long random strings in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# lax when the web app proxies /api (same site); none when API is on another site (requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Uploads (LocalStorageService) ------------------------------------------
UPLOAD_DIR=./uploads
MAX_PHOTO_MB=20
MAX_BANNER_MB=5

# --- Email. Without RESEND_API_KEY or SMTP_HOST, emails are only logged to the console (dev). --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Weddyzone Studio <no-reply@weddyzone.app>"
# Resend (recommended): API key from resend.com. When set, emails go through Resend instead of SMTP.
RESEND_API_KEY=
# Sender for all emails; its domain must be verified in Resend. Required in production.
MAIL_FROM="Weddyzone Studio <no-reply@weddyzone.app>"

# --- Rate limits (requests per minute) --------------------------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_PUBLIC_PER_MIN=120
# Proxies in front of the API: 1 locally / direct, 2 behind Vercel's /api rewrite + Railway/Render
TRUST_PROXY_HOPS=1

# Mirrors the web flag; reported to the web app via /auth/me
FEATURE_FACE_RECOGNITION=false

# Used by Playwright (reset + seeded before every e2e run)
E2E_DATABASE_URL=postgresql://weddyzone@localhost:5433/weddyzone_e2e?schema=public
